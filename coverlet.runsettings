<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Measured across the whole application (pages, controllers, middleware, startup):
            the end-to-end tests host the real app in-process, so those layers are exercised
            too. Only EF Core's generated migration code is left out; it is not hand-written
            logic, and MigrationTests already prove it applies and matches the model.
          -->
          <Exclude>[GitServer]GitServer.Data.Migrations.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
