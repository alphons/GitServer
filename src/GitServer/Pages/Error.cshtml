@page "/dashboard/Error"
@model GitServer.Pages.ErrorModel
@{
	ViewData["Title"] = L["error_page_title"];
}
<div class="container">
	<h1>@L["error_page_title"]</h1>
	@if (Model.ShowRequestId)
	{
		<p class="text-muted">@L["error_page_request_id"]: <code>@Model.RequestId</code></p>
	}
	<p><a href="/">@L["error_page_home"]</a></p>
</div>
