@page "/dashboard/Admin/GitVersion"
@model GitServer.Pages.Admin.GitVersionModel
@{
	ViewData["Title"] = L["admin_gitversion_title"];
}
<div class="container">
	<h1>@L["nav_admin"]</h1>

	@await Html.PartialAsync("_AdminNav", "git-version")

	<h2>@L["admin_gitversion_title"]</h2>
	<p class="text-muted">@L["admin_gitversion_hint"]</p>

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
	}

	<p>@L["admin_gitversion_current"]: <strong>@Model.CurrentVersion</strong></p>

	@if (!Model.IsManagedByInstaller)
	{
		<p>@L["admin_gitversion_system_path"]: <code>@Model.GitPath</code></p>
		<p class="text-muted">@L["admin_gitversion_system_managed"]</p>
	}
	else
	{

	<form method="post" asp-page-handler="CheckUpdate" style="display:inline">
		<button type="submit" class="btn btn-primary">@L["admin_gitversion_check_update"]</button>
	</form>

	@if (Model.LatestRelease != null)
	{
		var alreadyInstalled = Model.Installations.Any(i => i.TagName == Model.LatestRelease.TagName);
		<p id="latest-release-row">
			@L["admin_gitversion_latest_available"]: <strong>@Model.LatestRelease.Version</strong> (@Model.LatestRelease.TagName)
			@if (!alreadyInstalled)
			{
				<button type="button" id="install-btn" class="btn btn-primary"
						data-tag-name="@Model.LatestRelease.TagName">@L["admin_gitversion_install"]</button>
			}
			else
			{
				<span class="text-muted">(@L["admin_gitversion_already_installed"])</span>
			}
		</p>
	}

	<div id="install-progress" hidden>
		<progress id="install-progress-bar" max="100" value="0" style="width: 300px"></progress>
		<span id="install-progress-text"></span>
	</div>
	<div id="install-progress-error" class="alert alert-danger" hidden></div>
	<form id="antiforgery-form">@Html.AntiForgeryToken()</form>

	<h3>@L["admin_gitversion_installed_title"]</h3>
	@if (Model.Installations.Count > 0)
	{
		<table class="data-table">
			<thead>
				<tr>
					<th>@L["admin_col_version"]</th>
					<th>@L["admin_col_installed"]</th>
					<th>@L["admin_col_status"]</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var installation in Model.Installations)
				{
					var filesPresent = Model.FilesPresent.GetValueOrDefault(installation.Id);
					<tr>
						<td><code>@installation.Version</code></td>
						<td>@TZ.FormatDateTime(installation.InstalledAt)</td>
						<td>
							@if (!filesPresent)
							{
								<span class="badge badge-private">@L["admin_gitversion_missing"]</span>
							}
							else if (installation.IsActive)
							{
								<span class="badge badge-public">@L["admin_gitversion_active"]</span>
							}
						</td>
						<td>
							@if (!installation.IsActive && filesPresent)
							{
								<form method="post" asp-page-handler="Activate" style="display:inline">
									<input type="hidden" name="id" value="@installation.Id" />
									<button type="submit" class="btn btn-sm btn-primary">@L["admin_gitversion_activate"]</button>
								</form>
							}
							@if (filesPresent)
							{
								<button type="button" class="btn btn-sm btn-ghost browse-btn"
										data-installation-id="@installation.Id">@L["admin_gitversion_browse"]</button>
							}
							@if (!installation.IsActive || !filesPresent)
							{
								<form method="post" asp-page-handler="Delete" style="display:inline">
									<input type="hidden" name="id" value="@installation.Id" />
									<button type="submit" class="btn btn-sm btn-danger">@L["delete_button"]</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	else
	{
		<p class="text-muted">@L["admin_gitversion_no_installations"]</p>
	}
	}
</div>

<div id="browse-modal" class="browse-modal-backdrop" hidden>
	<div class="browse-modal">
		<div class="browse-modal-header">
			<span id="browse-breadcrumb" class="browse-breadcrumb"></span>
			<button type="button" id="browse-modal-close" class="btn btn-ghost btn-sm" aria-label="Close">&times;</button>
		</div>
		<div class="browse-modal-body">
			<ul id="browse-list" class="browse-list"></ul>
			<button type="button" id="browse-back-btn" class="btn btn-ghost btn-sm" hidden>&larr; @L["admin_gitversion_back"]</button>
			<pre id="browse-file-content" class="browse-file-content" hidden></pre>
		</div>
	</div>
</div>

<style>
	.browse-modal-backdrop {
		position: fixed; inset: 0; background: rgba(0,0,0,0.6);
		align-items: center; justify-content: center; z-index: 1000;
	}
	.browse-modal-backdrop:not([hidden]) { display: flex; }
	.browse-modal {
		background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
		width: min(720px, 90vw); height: min(560px, 80vh);
		display: flex; flex-direction: column; overflow: hidden;
	}
	.browse-modal-header {
		display: flex; align-items: center; justify-content: space-between;
		padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); background: var(--surface2);
	}
	.browse-breadcrumb { font-family: monospace; font-size: 0.85rem; color: var(--text-muted); word-break: break-all; }
	.browse-modal-body { flex: 1; overflow: auto; padding: 0.5rem 1rem; }
	.browse-list { list-style: none; margin: 0; padding: 0; }
	.browse-list li {
		padding: 0.35rem 0.4rem; cursor: pointer; border-radius: 4px; font-family: monospace; font-size: 0.9rem;
	}
	.browse-list li:hover { background: var(--surface2); }
	.browse-list li.is-dir::before { content: "\1F4C1  "; }
	.browse-list li.is-file::before { content: "\1F4C4  "; }
	.browse-file-content {
		font-family: "Cascadia Code", Consolas, monospace; font-size: 0.85rem; white-space: pre-wrap;
		word-break: break-all; color: var(--text); margin: 0;
	}
</style>

@section Scripts {
	<script src="~/js/git-version.js" asp-append-version="true"></script>
}
