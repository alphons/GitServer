@page "/dashboard/Admin/Settings"
@model GitServer.Pages.Admin.SettingsModel
@{
	ViewData["Title"] = L["admin_settings_title"];
}
<div class="container">
	<h1>@L["nav_admin"]</h1>

	@await Html.PartialAsync("_AdminNav", "settings")

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert alert-success">@Model.Message</div>
	}

	<p class="text-muted">@L["admin_settings_hint"]</p>

	<form method="post">
		<div class="form-group">
			<label class="checkbox-label">
				<input asp-for="AllowRegistration" type="checkbox" />
				@L["admin_settings_allow_registration"]
			</label>
			<small class="text-muted">@L["admin_settings_allow_registration_hint"]</small>
		</div>

		<div class="form-group">
			<label class="checkbox-label">
				<input asp-for="AllowUserRepoCreation" type="checkbox" />
				@L["admin_settings_allow_user_repo_creation"]
			</label>
			<small class="text-muted">@L["admin_settings_allow_user_repo_creation_hint"]</small>
		</div>

		<div class="form-group">
			<label class="checkbox-label">
				<input asp-for="AllowPushToCreateRepositories" type="checkbox" />
				@L["admin_settings_allow_push_to_create"]
			</label>
			<small class="text-muted">@L["admin_settings_allow_push_to_create_hint"]</small>
		</div>

		<div class="form-group">
			<label class="checkbox-label">
				<input asp-for="AllowAnonymousPush" type="checkbox" />
				@L["admin_settings_allow_anonymous_push"]
			</label>
			<small class="text-muted">@L["admin_settings_allow_anonymous_push_hint"]</small>
		</div>

		<div class="form-group">
			<label class="checkbox-label">
				<input asp-for="ShowCommitAuthorAvatar" type="checkbox" />
				@L["admin_settings_show_commit_avatar"]
			</label>
			<small class="text-muted">@L["admin_settings_show_commit_avatar_hint"]</small>
		</div>

		<div class="form-group">
			<label for="ApiKeyLifetimeDays">@L["admin_settings_apikey_lifetime"]</label>
			<input asp-for="ApiKeyLifetimeDays" type="number" min="1" max="3650" class="form-control" style="max-width:8rem" />
			<small class="text-muted">@L["admin_settings_apikey_lifetime_hint"]</small>
		</div>

		<button type="submit" class="btn btn-primary">@L["admin_save_button"]</button>
	</form>
</div>
