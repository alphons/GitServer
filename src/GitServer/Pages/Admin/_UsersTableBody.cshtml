@model GitServer.Pages.Admin.UsersModel
@{
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize) : 1;
    if (totalPages < 1) totalPages = 1;
}
<table class="data-table">
    <thead>
        <tr>
            <th>@L["admin_col_user"]</th>
            <th>@L["admin_col_display_name"]</th>
            <th>@L["email_label"]</th>
            <th>@L["admin_col_created"]</th>
            <th>@L["admin_col_last_login"]</th>
            <th>@L["admin_col_status"]</th>
            <th>@L["admin_col_admin"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr class="user-row" style="cursor:pointer"
                data-user-id="@user.Id"
                data-username="@user.UserName"
                data-display-name="@user.DisplayName"
                data-email="@user.Email"
                data-is-disabled="@(user.IsDisabled ? "true" : "false")"
                data-is-admin="@(user.IsAdmin ? "true" : "false")"
                data-is-pending="@(user.EmailConfirmed ? "false" : "true")"
                data-is-self="@(user.Id == Model.CurrentUserId ? "true" : "false")">
                <td>
                    @if (user.EmailConfirmed)
                    {
                        @user.UserName
                    }
                    else
                    {
                        <span class="badge badge-read">@L["admin_pending_registration"]</span>
                    }
                </td>
                <td>@user.DisplayName</td>
                <td>@user.Email</td>
                <td>@TZ.ToLocal(user.CreatedAt).ToString("d", L.CurrentCulture)</td>
                <td>@(user.LastLoginAt.HasValue ? TZ.ToLocal(user.LastLoginAt.Value).ToString("g", L.CurrentCulture) : L["admin_never_logged_in"])</td>
                <td>
                    @if (user.IsDisabled)
                    {
                        <span class="badge badge-write" style="background:rgba(248,81,73,0.15);color:var(--danger)">@L["admin_status_disabled"]</span>
                    }
                    else
                    {
                        <span class="badge badge-write">@L["admin_status_enabled"]</span>
                    }
                </td>
                <td>@if (user.IsAdmin) { <text>&#x2714;</text> }</td>
            </tr>
        }
        @if (!Model.Users.Any())
        {
            <tr><td colspan="7" class="text-muted">@L["explore_no_results"]</td></tr>
        }
    </tbody>
</table>

<div class="pagination" id="users-pagination" data-page="@Model.Page" data-has-next="@(Model.HasNextPage ? "true" : "false")">
    <button type="button" class="btn btn-secondary" id="users-prev-btn" @(Model.Page <= 0 ? "disabled" : "")>@L["pagination_prev"]</button>
    <span class="text-muted">@L.Format("admin_pagination_page_of", Model.Page + 1, totalPages)</span>
    <button type="button" class="btn btn-secondary" id="users-next-btn" @(!Model.HasNextPage ? "disabled" : "")>@L["pagination_next"]</button>
</div>
