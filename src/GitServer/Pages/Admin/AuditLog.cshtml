@page "/dashboard/Admin/AuditLog"
@model GitServer.Pages.Admin.AuditLogModel
@{
	ViewData["Title"] = L["admin_audit_title"];
	var labels = new Dictionary<string, string>
	{
		["time"] = L["admin_audit_col_time"],
		["user"] = L["admin_col_user"],
		["action"] = L["admin_audit_col_action"],
		["target"] = L["admin_audit_col_target"],
		["details"] = L["admin_audit_col_details"],
		["ip"] = L["admin_audit_col_ip"],
		["empty"] = L["admin_audit_empty"],
		["prev"] = L["pagination_prev"],
		["next"] = L["pagination_next"],
	};
}
<div class="container">
	<h1>@L["nav_admin"]</h1>

	@await Html.PartialAsync("_AdminNav", "audit")

	<h2>@L["admin_audit_title"]</h2>
	<p class="text-muted">@L["admin_audit_hint"]</p>

	<div class="search-form search-form-full">
		<input id="audit-filter" type="search" class="form-control" placeholder="@L["explore_search_placeholder"]" autocomplete="off" />
		<a id="audit-export" class="btn btn-secondary" href="/api/admin/audit/export">@L["admin_audit_export"]</a>
	</div>
	<div id="audit-list"></div>
	<script type="application/json" id="audit-labels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels))</script>
</div>

@section Scripts {
	<script src="~/js/audit-log.js" asp-append-version="true"></script>
}
