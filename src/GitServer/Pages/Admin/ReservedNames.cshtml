@page "/dashboard/Admin/ReservedNames"
@model GitServer.Pages.Admin.ReservedNamesModel
@{
	ViewData["Title"] = L["admin_reserved_names_title"];
	var labels = new Dictionary<string, string>
	{
		["pattern"] = L["admin_col_pattern"],
		["builtIn"] = L["admin_reserved_builtin_label"],
		["edit"] = L["admin_edit_button"],
		["save"] = L["admin_save_button"],
		["cancel"] = L["cancel"],
		["delete"] = L["delete_button"],
		["empty"] = L["admin_reserved_none"],
		["failed"] = L["admin_reserved_failed"],
	};
}
<div class="container">
	<h1>@L["nav_admin"]</h1>

	@await Html.PartialAsync("_AdminNav", "reserved-names")

	<h2>@L["admin_reserved_names_title"]</h2>
	<p class="text-muted">@L["admin_reserved_names_hint"]</p>

	<div id="reserved-error" class="alert alert-danger" hidden></div>
	<div id="reserved-list"></div>
	<script type="application/json" id="reserved-labels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels))</script>

	<form id="reserved-add-form" class="form-inline">
		<div class="form-group">
			<label for="reserved-new">@L["admin_add_pattern_label"]</label>
			<input id="reserved-new" type="text" class="form-control" placeholder="user*" maxlength="64" required autocomplete="off" />
		</div>
		<button type="submit" class="btn btn-primary">@L["admin_add_pattern_button"]</button>
	</form>
	<form id="antiforgery-form">@Html.AntiForgeryToken()</form>
</div>

@section Scripts {
	<script src="~/js/reserved-names.js" asp-append-version="true"></script>
}
