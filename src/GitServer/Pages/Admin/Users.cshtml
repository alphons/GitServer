@page "/dashboard/Admin/Users"
@model GitServer.Pages.Admin.UsersModel
@{
	ViewData["Title"] = L["admin_users_title"];
}
<div class="container">
	<h1>@L["nav_admin"]</h1>

	@await Html.PartialAsync("_AdminNav", "users")

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert alert-success">@Model.Message</div>
	}
	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-danger">@Model.ErrorMessage</div>
	}

	<div class="search-form search-form-full" style="display:flex; gap:0.5rem; align-items:center">
		<input type="search" class="form-control" id="users-filter" placeholder="@L["admin_users_filter_placeholder"]" value="@Model.Filter" data-page="@Model.Page" style="flex:1" />
		<button type="button" id="new-user-btn" class="btn btn-primary">@L["admin_new_user_button"]</button>
	</div>

	<div id="users-list-container"></div>
	<script type="application/json" id="admin-users-strings">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
		{
			editTitle = (string)L["admin_edit_user_title"],
			newTitle = (string)L["admin_new_user_title"],
			confirmDeleteTemplate = (string)L["confirm_delete_user"],
			labels = new Dictionary<string, string>
			{
				["user"] = L["admin_col_user"],
				["displayName"] = L["admin_col_display_name"],
				["email"] = L["email_label"],
				["created"] = L["admin_col_created"],
				["lastLogin"] = L["admin_col_last_login"],
				["status"] = L["admin_col_status"],
				["admin"] = L["admin_col_admin"],
				["pending"] = L["admin_pending_registration"],
				["never"] = L["admin_never_logged_in"],
				["enabled"] = L["admin_status_enabled"],
				["disabled"] = L["admin_status_disabled"],
				["noResults"] = L["explore_no_results"],
				["prev"] = L["pagination_prev"],
				["next"] = L["pagination_next"],
				["pageOf"] = L["admin_pagination_page_of"],
			},
		}))</script>
</div>

<div id="user-modal-backdrop" class="user-modal-backdrop" hidden>
	<div class="user-modal">
		<form method="post" asp-page-handler="Save" id="user-form">
			<div class="user-modal-header">
				<span id="user-modal-title"></span>
				<button type="button" id="user-modal-close" class="btn btn-ghost btn-sm" aria-label="Close">&times;</button>
			</div>
			<div class="user-modal-body">
				<input type="hidden" name="userId" id="f-userId" />
				<input type="hidden" name="q" id="f-q" />
				<input type="hidden" name="p" id="f-p" />

				<p id="f-pending-hint" class="text-muted" hidden>@L["admin_validate_hint"]</p>

				<div class="form-group">
					<label for="f-userName">@L["username_label"]</label>
					<input type="text" class="form-control" id="f-userName" name="userName" required />
				</div>
				<div class="form-group">
					<label for="f-displayName">@L["display_name_label"]</label>
					<input type="text" class="form-control" id="f-displayName" name="displayName" />
				</div>
				<div class="form-group">
					<label for="f-email">@L["email_label"]</label>
					<input type="email" class="form-control" id="f-email" name="email" required />
				</div>
				<div class="form-group" id="f-status-group">
					<label for="f-isDisabled">@L["admin_field_status"]</label>
					<select class="form-control" id="f-isDisabled" name="isDisabled">
						<option value="false">@L["admin_status_enabled"]</option>
						<option value="true">@L["admin_status_disabled"]</option>
					</select>
				</div>
				<div class="form-group" id="f-admin-group">
					<label>
						<input type="checkbox" id="f-isAdmin" name="isAdmin" value="true" />
						@L["admin_field_is_admin"]
					</label>
					<input type="hidden" name="isAdmin" value="false" />
				</div>

				<div class="form-group">
					<label for="f-newPassword">@L["reset_password_new_password_label"]</label>
					<input type="password" class="form-control" id="f-newPassword" name="newPassword" autocomplete="new-password" />
					<small id="f-password-hint" class="text-muted">@L["admin_password_leave_blank"]</small>
				</div>
				<div class="form-group">
					<label for="f-confirmPassword">@L["confirm_password_label"]</label>
					<input type="password" class="form-control" id="f-confirmPassword" name="confirmPassword" autocomplete="new-password" />
				</div>
			</div>
			<div class="user-modal-footer">
				<button type="button" id="user-delete-btn" class="btn btn-danger">@L["delete_button"]</button>
				<span style="flex:1"></span>
				<button type="button" id="user-cancel-btn" class="btn btn-ghost">@L["cancel"]</button>
				<button type="submit" class="btn btn-primary">@L["admin_save_button"]</button>
			</div>
		</form>
	</div>
</div>

<form method="post" asp-page-handler="Delete" id="user-delete-form" style="display:none">
	<input type="hidden" name="userId" id="delete-userId" />
	<input type="hidden" name="q" id="delete-q" />
	<input type="hidden" name="p" id="delete-p" />
</form>

<div id="confirm-modal-backdrop" class="user-modal-backdrop" hidden>
	<div class="user-modal confirm-modal">
		<div class="user-modal-body" id="confirm-modal-text"></div>
		<div class="user-modal-footer">
			<span style="flex:1"></span>
			<button type="button" id="confirm-modal-cancel" class="btn btn-ghost">@L["cancel"]</button>
			<button type="button" id="confirm-modal-ok" class="btn btn-danger">@L["delete_button"]</button>
		</div>
	</div>
</div>

<style>
	.user-modal-backdrop {
		position: fixed; inset: 0; background: rgba(0,0,0,0.6);
		align-items: center; justify-content: center; z-index: 1000;
	}
	.user-modal-backdrop:not([hidden]) { display: flex; }
	.user-modal {
		background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
		width: min(480px, 90vw); max-height: 85vh; overflow: auto;
	}
	.user-modal-header {
		display: flex; align-items: center; justify-content: space-between;
		padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); background: var(--surface2);
		font-weight: 600;
	}
	.user-modal-body { padding: 1rem; }
	.user-modal-footer {
		display: flex; align-items: center; gap: 0.5rem;
		padding: 0.6rem 1rem; border-top: 1px solid var(--border);
	}
	.confirm-modal { width: min(420px, 90vw); z-index: 1100; }
	#confirm-modal-backdrop { z-index: 1100; }
	#users-pagination { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.75rem; }
</style>

@section Scripts {
	<script src="~/js/admin-users.js" asp-append-version="true"></script>
}
