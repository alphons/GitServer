@page "/explore/users"
@model GitServer.Pages.ExploreUsersModel
@{
    ViewData["Title"] = L["explore_nav_users"];
}
<div class="container">
    <div class="page-header">
        <h1>@L["nav_explore"]</h1>
    </div>

    @await Html.PartialAsync("_ExploreNav", "users")

    <form method="get" class="search-form search-form-full">
        <input name="q" type="search" class="form-control" placeholder="@L["explore_users_search_placeholder"]"
               value="@Model.Query" autofocus />
        <button type="submit" class="btn btn-primary">@L["search_button"]</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <p class="search-results-info">@Model.Users.Count @L["explore_results_for"] "<strong>@Model.Query</strong>"</p>
    }

    @{
        var prevUrl = $"/explore/users?q={Uri.EscapeDataString(Model.Query)}&p={Model.Page - 1}";
        var nextUrl = $"/explore/users?q={Uri.EscapeDataString(Model.Query)}&p={Model.Page + 1}";
    }
    @if (Model.Page > 0 || Model.HasNextPage)
    {
        @await Html.PartialAsync("_Pagination", (Model.Page, Model.HasNextPage, prevUrl, nextUrl))
    }

    @if (Model.Users.Any())
    {
        <div class="user-list">
            @foreach (var user in Model.Users)
            {
                <a class="user-card" href="/User/@user.UserName">
                    <img src="@user.EffectiveAvatarUrl" alt="@user.UserName" class="avatar-img avatar-md" />
                    <div class="user-card-info">
                        <div class="user-card-name">@user.DisplayName</div>
                        <div class="text-muted user-card-username">@@@user.UserName</div>
                        @if (!string.IsNullOrEmpty(user.Bio))
                        {
                            <p class="user-card-bio">@user.Bio</p>
                        }
                        @if (!string.IsNullOrEmpty(user.CompanyName) || !string.IsNullOrEmpty(user.Country))
                        {
                            <p class="text-muted user-card-meta">
                                @if (!string.IsNullOrEmpty(user.CompanyName))
                                {
                                    <span>&#127970; @user.CompanyName</span>
                                }
                                @if (!string.IsNullOrEmpty(user.Country))
                                {
                                    <span>&#127760; @L.CountryName(user.Country)</span>
                                }
                            </p>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">@L["explore_no_results"]</div>
    }
    @if (Model.Page > 0 || Model.HasNextPage)
    {
        @await Html.PartialAsync("_Pagination", (Model.Page, Model.HasNextPage, prevUrl, nextUrl))
    }
</div>
