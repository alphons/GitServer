@page "/{user}/{repo}/collaborators"
@model GitServer.Pages.Repo.CollaboratorsModel
@{
	ViewData["Title"] = $"{L["settings_collaborators"]} - {Model.UserName}/{Model.RepoName}";
}
<div class="container">
	<div class="repo-header">
		<div class="repo-title">
			<a href="/dashboard/@(Model.Repo!.GroupOwnerId != null ? "Group" : "User")/@Model.UserName">@Model.UserName</a> /
			<a href="/@Model.UserName/@Model.RepoName"><strong>@Model.RepoName</strong></a>
		</div>
	</div>

	@await Html.PartialAsync("_RepoNav", (Model.UserName, Model.RepoName, "collaborators"))

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
	}

	<section class="settings-section">
		<h2>@L["settings_collaborators"]</h2>
		<p class="text-muted">@L["settings_collaborators_hint"]</p>

		@if (Model.Collaborators.Count > 0)
		{
			<table class="data-table collaborators-table">
				<thead>
					<tr>
						<th>@L["settings_collaborator_user"]</th>
						<th>@L["settings_collaborator_level"]</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var access in Model.Collaborators)
					{
						<tr>
							<td>
								@if (access.User != null)
								{
									<a href="/dashboard/User/@access.User.UserName" class="collaborator-user">
										<img src="@access.User.EffectiveAvatarUrl" class="avatar-img avatar-sm" alt="" />
										<span>
											<strong>@access.User.UserName</strong>
											@if (!string.IsNullOrEmpty(access.User.DisplayName))
											{
												<span class="text-muted"> — @access.User.DisplayName</span>
											}
										</span>
									</a>
								}
								else if (access.Group != null)
								{
									<span class="collaborator-user">
										<span class="badge badge-group">@L["group_label"]</span>
										<strong>@access.Group.Name</strong>
									</span>
								}
							</td>
							<td>
								<span class="badge @(access.Level == AccessLevel.Write ? "badge-write" : "badge-read")">
									@(access.Level == AccessLevel.Write ? L["settings_access_write"] : L["settings_access_read"])
								</span>
							</td>
							<td>
								<form method="post" asp-page-handler="RemoveCollaborator"
									  data-confirm="@L["settings_remove_collaborator_confirm"]"
									  data-confirm-ok="@L["delete_button"]" data-confirm-cancel="@L["cancel"]">
									<input type="hidden" name="accessId" value="@access.Id" />
									<button type="submit" class="btn btn-danger btn-sm">@L["delete_button"]</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="text-muted">@L["settings_no_collaborators"]</p>
		}

		<form method="post" asp-page-handler="AddCollaborator" class="form-inline collaborator-add-form">
			<div class="form-group collaborator-search">
				<label for="collaboratorName">@L["settings_collaborator_username"]</label>
				<input asp-for="CollaboratorName" id="collaboratorName" type="text" class="form-control"
					   autocomplete="off" placeholder="@L["settings_collaborator_search_placeholder"]"
					   data-user-name="@Model.UserName" data-repo-name="@Model.RepoName" />
				<div id="collaboratorResults" class="collaborator-results"></div>
			</div>
			<div class="form-group">
				<label for="collaboratorLevel">@L["settings_collaborator_level"]</label>
				<select asp-for="CollaboratorLevel" id="collaboratorLevel" class="form-control">
					<option value="@AccessLevel.Read">@L["settings_access_read"]</option>
					<option value="@AccessLevel.Write">@L["settings_access_write"]</option>
				</select>
			</div>
			<button type="submit" class="btn btn-primary">@L["settings_add_collaborator"]</button>
		</form>

		@if (Model.OwnGroups.Count > 0)
		{
			<form method="post" asp-page-handler="AddGroup" class="form-inline collaborator-add-form">
				<div class="form-group">
					<label for="groupId">@L["group_label"]</label>
					<select asp-for="GroupId" id="groupId" class="form-control">
						@foreach (var group in Model.OwnGroups)
						{
							<option value="@group.Id">@group.Name</option>
						}
					</select>
				</div>
				<div class="form-group">
					<label for="groupLevel">@L["settings_collaborator_level"]</label>
					<select asp-for="GroupLevel" id="groupLevel" class="form-control">
						<option value="@AccessLevel.Read">@L["settings_access_read"]</option>
						<option value="@AccessLevel.Write">@L["settings_access_write"]</option>
					</select>
				</div>
				<button type="submit" class="btn btn-primary">@L["settings_add_group"]</button>
			</form>
		}
	</section>
</div>

@section Scripts {
	<script src="~/js/collaborator-search.js" asp-append-version="true"></script>
	<script src="~/js/collaborators.js" asp-append-version="true"></script>
}
