@page "/{user}/{repo}/blob/{branch}/{**path}"
@model GitServer.Pages.Repo.BlobModel
@{
	ViewData["Title"] = $"{Model.FilePath} &mdash; {Model.UserName}/{Model.RepoName}";
	var ext = System.IO.Path.GetExtension(Model.FilePath).TrimStart('.').ToLower();
	var imageExts = new HashSet<string> { "png", "jpg", "jpeg", "gif" };
	var isImage = imageExts.Contains(ext);
	var trimmedContent = Model.Content.TrimEnd('\n', '\r');
	var lineCount = trimmedContent.Length == 0 ? 0 : trimmedContent.Split('\n').Length;
	var canEdit = Model.CanEdit && !isImage && !Model.IsBinary && !Model.IsLfs;
	var isMarkdown = ext is "md" or "markdown";
	var apiUrl = $"/api/repos/{Uri.EscapeDataString(Model.UserName)}/{Uri.EscapeDataString(Model.RepoName)}/files";
	var fileName = Model.FilePath.Split('/')[^1];
	var i18nKeys = new[]
	{
		"file_edit_tabs", "file_edit_spaces", "file_edit_discard_confirm", "file_edit_discard", "file_edit_keep",
		"file_edit_dlg_branch", "file_edit_default_message", "file_edit_no_changes", "file_edit_error_failed", "file_edit_loading",
	};
}
<div class="container">
	<div class="repo-header">
		<div class="repo-title">
			<a href="/dashboard/@(Model.IsGroupOwner ? "Group" : "User")/@Model.UserName">@Model.UserName</a> /
			<a href="/@Model.UserName/@Model.RepoName"><strong>@Model.RepoName</strong></a>
		</div>
	</div>

	@await Html.PartialAsync("_RepoNav", (Model.UserName, Model.RepoName, "code"))

	<div class="file-breadcrumb">
		<a href="/@Model.UserName/@Model.RepoName?branch=@Model.Branch">@Model.RepoName</a>
		@{
			var parts = Model.FilePath.Split('/');
			var accumulated = "";
		}
		@for (int i = 0; i < parts.Length - 1; i++)
		{
			accumulated += (i > 0 ? "/" : "") + parts[i];
			var acc = accumulated;
			<span class="separator">/</span>
			<a href="/@Model.UserName/@Model.RepoName?branch=@Model.Branch&path=@acc">@parts[i]</a>
		}
		<span class="separator">/</span>
		<strong>@parts[^1]</strong>
	</div>

	<div class="file-view" id="fileView"
		 data-api="@apiUrl" data-branch="@Model.Branch" data-path="@Model.FilePath" data-file-name="@fileName" data-markdown="@(isMarkdown ? "true" : "false")">
		<div class="file-view-header">
			<div class="file-view-info text-muted">
				<span>@L["repo_nav_code"]</span>
				@if (!isImage && !Model.IsBinary)
				{
					<span class="separator">&middot;</span>
					<span>@L.Format("file_lines", lineCount)</span>
				}
				<span class="separator">&middot;</span>
				<span>@L.Format("file_bytes", Model.FileSize)</span>
				@if (Model.IsLfs)
				{
					<span class="separator">&middot;</span>
					<span class="badge badge-muted" title="@L["lfs_stored_hint"]">@L["lfs_stored"]</span>
				}
			</div>
			@if (canEdit)
			{
				<div class="file-view-actions" id="editActions" hidden>
					<button type="button" class="btn btn-secondary btn-sm" id="editCancelBtn">@L["file_edit_cancel"]</button>
					<button type="button" class="btn btn-primary btn-sm" id="editCommitBtn" disabled>@L["file_edit_commit"]</button>
				</div>
			}
			<div class="file-view-actions" id="viewActions">
				@if (canEdit)
				{
					<button type="button" class="file-action-link edit-link" id="editBtn">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
							<path d="M12 20h9" />
							<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
						</svg>
						@L["file_edit"]
					</button>
				}
				<a class="file-action-link" href="/@Model.UserName/@Model.RepoName/raw/@Model.Branch/@Model.FilePath">@L["file_raw"]</a>
				<button type="button" class="icon-btn" id="copyRawBtn" title="@L["file_copy_raw"]" aria-label="@L["file_copy_raw"]" data-copied="@L["file_copied"]">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="9" y="9" width="11" height="11" rx="1" />
						<path d="M5 15V5a1 1 0 0 1 1-1h10" />
					</svg>
				</button>
				<a class="icon-btn" href="/@Model.UserName/@Model.RepoName/raw/@Model.Branch/@Model.FilePath" download title="@L["file_download_raw"]" aria-label="@L["file_download_raw"]">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 3v12" />
						<path d="M7 10l5 5 5-5" />
						<path d="M5 21h14" />
					</svg>
				</a>
			</div>
		</div>
		@if (isImage)
		{
			<div class="file-image">
				<img src="/@Model.UserName/@Model.RepoName/raw/@Model.Branch/@Model.FilePath" alt="@Model.FilePath" />
			</div>
		}
		else if (Model.IsLfs && !Model.LfsObjectPresent)
		{
			<div class="file-binary-notice">@L["lfs_object_missing"]</div>
		}
		else if (Model.IsBinary)
		{
			<div class="file-binary-notice">@L["file_binary"]</div>
		}
		else
		{
			<div class="file-content" id="fileContent">
				<pre class="code-view lang-@ext"><span class="line-numbers">@string.Join("\n", Enumerable.Range(1, lineCount))</span><code class="language-@ext">@trimmedContent</code></pre>
			</div>
			@if (canEdit)
			{
				<div class="file-editor" id="fileEditor" hidden>
					<div class="editor-toolbar">
						<div class="editor-tabs" role="tablist">
							<button type="button" class="editor-tab active" role="tab" id="edTabEdit" aria-selected="true">@L["file_edit_tab_edit"]</button>
							<button type="button" class="editor-tab" role="tab" id="edTabPreview" aria-selected="false">@L["file_edit_tab_preview"]</button>
						</div>
						<div class="editor-options" id="edOptions">
							<select id="edIndentMode" class="form-control" title="@L["file_edit_indent_mode"]" aria-label="@L["file_edit_indent_mode"]">
								<option value="tabs">@L["file_edit_tabs"]</option>
								<option value="spaces">@L["file_edit_spaces"]</option>
							</select>
							<select id="edIndentSize" class="form-control" title="@L["file_edit_indent_size"]" aria-label="@L["file_edit_indent_size"]">
								<option value="2">2</option>
								<option value="4">4</option>
								<option value="8">8</option>
							</select>
							<select id="edWrap" class="form-control" title="@L["file_edit_wrap_mode"]" aria-label="@L["file_edit_wrap_mode"]">
								<option value="off">@L["file_edit_nowrap"]</option>
								<option value="soft">@L["file_edit_softwrap"]</option>
							</select>
						</div>
					</div>
					<div class="editor-error" id="edError" role="alert" hidden></div>
					<div class="editor-pane" id="edPane">
						<div class="editor-gutter" id="edGutter" aria-hidden="true"></div>
						<textarea id="edText" class="editor-text" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off" aria-label="@fileName"></textarea>
					</div>
					<div class="editor-preview" id="edPreview" hidden></div>
				</div>
			}
		}
	</div>
</div>

@if (canEdit)
{
	<form id="antiforgery-form">@Html.AntiForgeryToken()</form>
	<div class="gs-confirm-backdrop" id="commitDialog" hidden>
		<div class="gs-confirm-modal commit-modal" role="dialog" aria-modal="true" aria-labelledby="commitDlgTitle">
			<div class="gs-confirm-text">
				<h3 id="commitDlgTitle">@L["file_edit_dlg_title"]</h3>
				<div class="form-group">
					<label for="commitMessage">@L["file_edit_dlg_message"]</label>
					<input type="text" id="commitMessage" class="form-control" maxlength="200" autocomplete="off" />
				</div>
				<div class="form-group">
					<label for="commitDescription">@L["file_edit_dlg_description"]</label>
					<textarea id="commitDescription" class="form-control" rows="4"></textarea>
				</div>
				<p class="text-muted" id="commitBranchInfo"></p>
				<div class="editor-error" id="commitError" role="alert" hidden></div>
			</div>
			<div class="gs-confirm-actions">
				<button type="button" class="btn btn-primary" id="commitOkBtn">@L["file_edit_dlg_commit"]</button>
				<button type="button" class="btn btn-ghost" id="commitCancelBtn">@L["file_edit_dlg_cancel"]</button>
			</div>
		</div>
	</div>
	<script type="application/json" id="blobEditI18n">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(i18nKeys.ToDictionary(k => k, k => L[k])))</script>
}

@section Scripts {
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css">
	<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
	@if (canEdit)
	{
		if (isMarkdown)
		{
			<script src="~/js/markdown/md4-entities.js" asp-append-version="true"></script>
			<script src="~/js/markdown/md4.js" asp-append-version="true"></script>
		}
		<script src="~/js/blob-edit.js" asp-append-version="true"></script>
	}
	<script src="~/js/blob.js" asp-append-version="true"></script>
}
