@page "/{user}/{repo}"
@model GitServer.Pages.Repo.ViewModel
@{
	ViewData["Title"] = $"{Model.UserName}/{Model.RepoName}";
}
<div class="container">
	<div class="repo-header">
		<div class="repo-title">
			<a href="/dashboard/@(Model.Repo!.GroupOwnerId != null ? "Group" : "User")/@Model.UserName">@Model.UserName</a>
			<span class="separator">/</span>
			<strong>@Model.RepoName</strong>
			<span class="badge @(Model.Repo!.IsPrivate ? "badge-warning" : "badge-muted")">
				@(Model.Repo.IsPrivate ? L["badge_private"] : L["badge_public"])
			</span>
			<span class="badge @(Model.Repo.GroupOwnerId != null ? "badge-group" : "badge-muted")">
				@(Model.Repo.GroupOwnerId != null ? L["group_label"] : L["user_label"])
			</span>
			@if (Model.Repo.IsReadOnly)
			{
				<span class="badge badge-warning">@L["settings_readonly_label"]</span>
			}
			<a class="btn btn-secondary btn-sm repo-fork-button" href="/@Model.UserName/@Model.RepoName/fork">
				@L["fork_button"] <span class="badge badge-muted">@Model.ForkCount</span>
			</a>
		</div>
		@if (Model.Repo.IsFork)
		{
			<p class="repo-fork-source">
				@if (Model.ShowForkSource)
				{
					var source = Model.Repo.ForkedFrom!;
					@L["fork_forked_from"] <a href="/@source.OwnerName/@source.Name">@source.OwnerName/@source.Name</a>
				}
				else if (Model.Repo.ForkedFromId == null)
				{
					@L["fork_source_deleted"]
				}
				else
				{
					@L["fork_source_hidden"]
				}
			</p>
		}
		@if (!string.IsNullOrEmpty(Model.Repo.Description))
		{
			<p class="repo-desc">@Model.Repo.Description</p>
		}
	</div>

	@await Html.PartialAsync("_RepoNav", (Model.UserName, Model.RepoName, "code"))

	@if (Model.IsEmpty)
	{
		<div class="empty-repo">
			<h2>@L["repo_empty_title"]</h2>
			<p>@L["repo_empty_start"]</p>
			<pre class="code-block">git clone @Model.CloneUrl
cd @Model.RepoName
echo "# @Model.RepoName" >> README.md
git add README.md
git commit -m "first commit"
git push -u origin @Model.DefaultBranch</pre>

			<p>@L["repo_empty_push"]</p>
			<pre class="code-block">cd @L["repo_empty_existing_dir"]
git remote add origin @Model.CloneUrl
git push -u origin @Model.DefaultBranch</pre>
		</div>
	}
	else
	{
		<div class="repo-toolbar">
			<div class="branch-selector">
				<select onchange="window.location='/@Model.UserName/@Model.RepoName?branch='+this.value">
					@foreach (var b in Model.Branches)
					{
						<option value="@b" selected="@(b == Model.CurrentBranch)">@b</option>
					}
				</select>
			</div>
			<div class="repo-counts">
				<a href="/@Model.UserName/@Model.RepoName/branches"><strong>@Model.Branches.Count</strong> @L["branches_title"]</a>
				<a href="/@Model.UserName/@Model.RepoName/tags"><strong>@Model.TagCount</strong> @L["tags_title"]</a>
			</div>
			<div class="repo-actions">
				<div class="clone-url-box">
					<input id="cloneUrl" type="text" readonly value="@Model.CloneUrl" class="form-control clone-input" />
					<button class="btn btn-secondary" onclick="copyCloneUrl()" data-copied="@L["file_copied"]">@L["copy_button"]</button>
				</div>
				@{var archiveBranch = Model.CurrentBranch;}
				<a class="btn btn-secondary" href="/@Model.UserName/@Model.RepoName/archive/@archiveBranch">
					ZIP
				</a>
			</div>
		</div>

		<div class="file-tree">
			@if (Model.LatestCommit is { } latest)
			{
				var commitBase = $"/{Model.UserName}/{Model.RepoName}/commit/";
				<div class="file-tree-header commit-bar">
					<div class="commit-bar-people">
						@foreach (var p in Model.CommitPeople)
						{
							<img class="commit-committer-avatar" src="@p.AvatarUrl" alt="@p.Name" />
						}
						<span class="commit-bar-names">
							@for (var i = 0; i < Model.CommitPeople.Count; i++)
							{
								var p = Model.CommitPeople[i];
								if (i > 0) { @(i == Model.CommitPeople.Count - 1 ? " & " : ", ") }
								if (p.ProfileUser != null) { <a href="/dashboard/User/@p.ProfileUser"><strong>@p.Name</strong></a> }
								else { <strong>@p.Name</strong> }
							}
						</span>
						<a class="commit-bar-message" href="@commitBase@latest.Sha" title="@latest.Message">@latest.Message</a>
					</div>
					<div class="commit-bar-meta">
						<span class="commit-hover">
							<a class="commit-sha" href="@commitBase@latest.Sha">@latest.ShortSha</a>
							<span class="commit-hover-card">
								<code>@latest.Sha</code>
								<span>@latest.Message</span>
								<span class="text-muted">@latest.Author &middot; @TZ.FormatDateTime(latest.Date)</span>
							</span>
						</span>
						<time class="time-ago" datetime="@latest.Date.ToUniversalTime().ToString("o")" title="@TZ.FormatDateTime(latest.Date)">@TZ.FormatDateTime(latest.Date)</time>
						<a class="commit-count" href="/@Model.UserName/@Model.RepoName/commits?branch=@Model.CurrentBranch"><strong>@Model.CommitCount</strong> @L["repo_nav_commits"]</a>
					</div>
				</div>
			}
			@if (!string.IsNullOrEmpty(Model.CurrentPath))
			{
				<div class="file-tree-header file-breadcrumb">
					<a href="/@Model.UserName/@Model.RepoName?branch=@Model.CurrentBranch">@Model.RepoName</a>
					@{
						var treeParts = Model.CurrentPath.Split('/');
						var treeAccumulated = "";
					}
					@for (int i = 0; i < treeParts.Length; i++)
					{
						treeAccumulated += (i > 0 ? "/" : "") + treeParts[i];
						var treeAcc = treeAccumulated;
						<span class="separator">/</span>
						@if (i == treeParts.Length - 1)
						{
							<strong>@treeParts[i]</strong>
						}
						else
						{
							<a href="/@Model.UserName/@Model.RepoName?branch=@Model.CurrentBranch&path=@treeAcc">@treeParts[i]</a>
						}
					}
				</div>
			}
			@foreach (var entry in Model.Tree)
			{
				var href = entry.Type == "tree"
					? $"/{Model.UserName}/{Model.RepoName}?branch={Model.CurrentBranch}&path={entry.Path}"
					: $"/{Model.UserName}/{Model.RepoName}/blob/{Model.CurrentBranch}/{entry.Path}";
				<a class="file-tree-entry" href="@href">
					@if (entry.Type == "tree")
					{
						<span class="file-icon dir-icon">&#128193;</span>
					}
					else
					{
						<span class="file-icon">&#128196;</span>
					}
					<span class="file-name">@entry.Name</span>
					@if (Model.LastCommits.TryGetValue(entry.Path, out var last))
					{
						<span class="file-commit-message" title="@last.Message">@last.Message</span>
						<time class="file-commit-time text-muted time-ago" datetime="@last.Date.ToUniversalTime().ToString("o")" title="@TZ.FormatDateTime(last.Date)">@TZ.FormatDateTime(last.Date)</time>
					}
				</a>
			}
		</div>

		@if (!string.IsNullOrEmpty(Model.ReadmePath))
		{
			var selectedVariants = Model.MdGroups[Model.SelectedMdBase];
			<div class="readme-container">
				<div class="readme-header">
					@if (Model.MdBases.Count > 1)
					{
						<select class="md-base-select" id="md-base-select">
							@foreach (var baseName in Model.MdBases)
							{
								<option value="@baseName" selected="@(baseName == Model.SelectedMdBase)">@baseName</option>
							}
						</select>
					}
					else
					{
						@Model.SelectedMdBase
					}
					<span class="readme-lang-picker" id="readme-lang-picker" hidden="@(selectedVariants.Count <= 1)">
						@foreach (var option in selectedVariants)
						{
							<button type="button" class="readme-lang-option@(option.FileName == Model.ReadmePath ? " active" : "")"
									data-readme-file="@option.FileName" title="@option.FileName">@option.Flag @(option.Lang ?? "default")</button>
						}
					</span>
				</div>
				<div class="readme-body markdown-body pane-output" id="readme-body"
					 data-readme-base="/@Model.UserName/@Model.RepoName/raw/@Model.CurrentBranch/"
					 data-link-dir="@Model.CurrentPath"
					 data-link-base="/@Model.UserName/@Model.RepoName/blob/@Model.CurrentBranch/"
					 data-image-base="/@Model.UserName/@Model.RepoName/raw/@Model.CurrentBranch/"
					 data-md-root-base="@(string.IsNullOrEmpty(Model.CurrentPath) ? $"/{Model.UserName}/{Model.RepoName}" : null)"
					 data-md-branch="@Model.CurrentBranch"
					 data-markdown-src="/@Model.UserName/@Model.RepoName/raw/@Model.CurrentBranch/@Model.ReadmePath"></div>
			</div>
			<script type="application/json" id="md-groups-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
				Model.MdGroups.ToDictionary(kv => kv.Key, kv => kv.Value.Select(v => new { file = v.FileName, lang = v.Lang, flag = v.Flag }))))</script>
		}
	}
</div>
@section Scripts {
	<script src="~/js/copy.js" asp-append-version="true"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css">
	<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
	<script src="~/js/markdown/md4-entities.js" asp-append-version="true"></script>
	<script src="~/js/markdown/md4.js" asp-append-version="true"></script>
	<script src="~/js/markdown/markdown-render.js" asp-append-version="true"></script>
	<script>
		// "3 days ago" in the page language; the server-rendered date stays as the fallback and the tooltip.
		(function () {
			if (!window.Intl || !Intl.RelativeTimeFormat) return;
			var rtf = new Intl.RelativeTimeFormat(document.documentElement.lang || undefined, { numeric: 'auto' });
			var units = [['year', 31536000], ['month', 2592000], ['day', 86400], ['hour', 3600], ['minute', 60]];
			document.querySelectorAll('time.time-ago').forEach(function (el) {
				var secs = (new Date(el.getAttribute('datetime')).getTime() - Date.now()) / 1000;
				if (isNaN(secs)) return;
				for (var i = 0; i < units.length; i++) {
					if (Math.abs(secs) >= units[i][1]) { el.textContent = rtf.format(Math.trunc(secs / units[i][1]), units[i][0]); return; }
				}
				el.textContent = rtf.format(Math.trunc(secs), 'second');
			});
		})();
		(function () {
			var body = document.getElementById('readme-body');
			if (!body) return;
			var rawBase = body.getAttribute('data-readme-base');
			var picker = document.getElementById('readme-lang-picker');
			var select = document.getElementById('md-base-select');
			var groupsEl = document.getElementById('md-groups-data');
			var groups = groupsEl ? JSON.parse(groupsEl.textContent) : {};

			function renderPicker(baseName, activeFile) {
				if (!picker) return;
				var variants = groups[baseName] || [];
				picker.innerHTML = '';
				picker.hidden = variants.length <= 1;
				variants.forEach(function (v) {
					var btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'readme-lang-option' + (v.file === activeFile ? ' active' : '');
					btn.setAttribute('data-readme-file', v.file);
					btn.title = v.file;
					btn.textContent = v.flag + ' ' + (v.lang || 'default');
					picker.appendChild(btn);
				});
			}

			if (picker) {
				picker.addEventListener('click', function (ev) {
					var btn = ev.target.closest('.readme-lang-option');
					if (!btn || btn.classList.contains('active')) return;
					picker.querySelectorAll('.readme-lang-option').forEach(function (b) { b.classList.remove('active'); });
					btn.classList.add('active');
					window.renderMarkdownFrom(body, rawBase + btn.getAttribute('data-readme-file'))
						.catch(function () { /* source unavailable — leave the container as is */ });
				});
			}

			if (select) {
				select.addEventListener('change', function () {
					var variants = groups[select.value] || [];
					if (variants.length === 0) return;
					var defaultFile = variants[0].file;
					renderPicker(select.value, defaultFile);
					window.renderMarkdownFrom(body, rawBase + defaultFile)
						.catch(function () { /* source unavailable — leave the container as is */ });
				});
			}
		})();
	</script>
}
