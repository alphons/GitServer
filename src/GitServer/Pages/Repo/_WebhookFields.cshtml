@* The fields of one webhook form, for adding and for editing. Prefix keeps the element ids unique when several forms share a page. *@
@model (string Url, GitServer.Models.WebhookEvents Events, bool Active, bool HasSecret, string Prefix)
@inject GitServer.Services.LocalizationService L
<div class="form-group">
	<label for="@(Model.Prefix)-url">@L["webhook_url_label"] <span class="required">*</span></label>
	<input id="@(Model.Prefix)-url" name="Url" type="url" class="form-control" value="@Model.Url" required placeholder="https://ci.example.com/hooks/gitserver" />
</div>
<div class="form-group">
	<label for="@(Model.Prefix)-secret">@L["webhook_secret_label"]</label>
	<input id="@(Model.Prefix)-secret" name="Secret" type="password" class="form-control" autocomplete="new-password"
		   placeholder="@(Model.HasSecret ? L["webhook_secret_keep"] : "")" />
	<span class="form-hint">@L["webhook_secret_hint"]</span>
	@if (Model.HasSecret)
	{
		<label class="checkbox-label"><input type="checkbox" name="RemoveSecret" value="true" /> @L["webhook_secret_remove"]</label>
	}
</div>
<div class="form-group">
	<span>@L["webhook_events_label"]</span>
	<label class="checkbox-label"><input type="checkbox" name="EventPush" value="true" checked="@Model.Events.HasFlag(GitServer.Models.WebhookEvents.Push)" /> @L["webhook_event_push"]</label>
	<label class="checkbox-label"><input type="checkbox" name="EventIssues" value="true" checked="@Model.Events.HasFlag(GitServer.Models.WebhookEvents.Issues)" /> @L["webhook_event_issues"]</label>
	<label class="checkbox-label"><input type="checkbox" name="EventIssueComment" value="true" checked="@Model.Events.HasFlag(GitServer.Models.WebhookEvents.IssueComment)" /> @L["webhook_event_issue_comment"]</label>
	<input type="hidden" name="EventPush" value="false" />
	<input type="hidden" name="EventIssues" value="false" />
	<input type="hidden" name="EventIssueComment" value="false" />
</div>
<div class="form-group">
	<label class="checkbox-label"><input type="checkbox" name="Active" value="true" checked="@Model.Active" /> @L["webhook_active_label"]</label>
	<input type="hidden" name="Active" value="false" />
</div>
