@model GitServer.Pages.Admin.SettingsModel.PathCheck
@if (Model.Ok)
{
	<span class="badge badge-success">&#10003; @L["admin_settings_path_writable"]</span>
}
else if (Model.Missing)
{
	<span class="badge badge-danger">&#10007; @L["admin_settings_path_missing"]</span>
}
else
{
	<span class="badge badge-danger">&#10007; @L["admin_settings_path_not_writable"]</span>
	@if (!string.IsNullOrEmpty(Model.Error))
	{
		<small class="text-muted">@Model.Error</small>
	}
}
