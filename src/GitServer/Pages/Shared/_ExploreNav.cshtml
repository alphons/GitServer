@model string
@inject GitServer.Services.LocalizationService L
<div class="repo-nav">
	<a class="repo-nav-link @(Model == "repos" ? "active" : "")"
	   href="/dashboard/Explore">@L["explore_nav_repos"]</a>
	<a class="repo-nav-link @(Model == "users" ? "active" : "")"
	   href="/dashboard/Explore/Users">@L["explore_nav_users"]</a>
</div>
