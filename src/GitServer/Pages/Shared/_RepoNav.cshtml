@model (string UserName, string RepoName, string ActiveTab)
@inject GitServer.Services.LocalizationService L
<div class="repo-nav">
	<a class="repo-nav-link @(Model.ActiveTab == "code" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName">@L["repo_nav_code"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "commits" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/commits">@L["repo_nav_commits"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "branches" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/branches">@L["branches_title"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "tags" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/tags">@L["tags_title"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "issues" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/issues">@L["repo_nav_issues"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "pulls" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/pulls">@L["pr_nav"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "collaborators" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/collaborators">@L["settings_collaborators"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "webhooks" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/webhooks">@L["webhooks_title"]</a>
	<a class="repo-nav-link @(Model.ActiveTab == "settings" ? "active" : "")"
	   href="/@Model.UserName/@Model.RepoName/settings">@L["repo_nav_settings"]</a>
</div>
