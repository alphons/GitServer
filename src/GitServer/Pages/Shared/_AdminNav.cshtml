@model string
@inject GitServer.Services.LocalizationService L
<div class="repo-nav">
	<a class="repo-nav-link @(Model == "users" ? "active" : "")"
	   href="/dashboard/Admin/Users">@L["admin_users_title"]</a>
	<a class="repo-nav-link @(Model == "blocked-emails" ? "active" : "")"
	   href="/dashboard/Admin/BlockedEmails">@L["nav_admin_blocked_emails"]</a>
	<a class="repo-nav-link @(Model == "reserved-names" ? "active" : "")"
	   href="/dashboard/Admin/ReservedNames">@L["nav_admin_reserved_names"]</a>
	<a class="repo-nav-link @(Model == "audit" ? "active" : "")"
	   href="/dashboard/Admin/AuditLog">@L["nav_admin_audit"]</a>
	<a class="repo-nav-link @(Model == "git-version" ? "active" : "")"
	   href="/dashboard/Admin/GitVersion">@L["nav_admin_git_version"]</a>
	<a class="repo-nav-link @(Model == "settings" ? "active" : "")"
	   href="/dashboard/Admin/Settings">@L["nav_admin_settings"]</a>
</div>
