@page "/User/{username}"
@model GitServer.Pages.User.ProfileModel
@{
    ViewData["Title"] = Model.ProfileUser?.UserName ?? L["profile_not_found"];
}
<div class="container">
    @if (Model.ProfileUser != null)
    {
        @await Html.PartialAsync("_ProfileHeader", Model.ProfileUser)

        @await Html.PartialAsync("_UserNav", (Model.ProfileUser.UserName!, "repositories", Model.IsOwner))

        <div class="search-form search-form-full">
            <input id="profile-repo-search" name="q" type="search" class="form-control"
                   placeholder="@L["explore_search_placeholder"]" value="@Model.Query" autocomplete="off" />
        </div>

        <div id="profile-repos-container">
            @await Html.PartialAsync("_ProfileRepos", Model)
        </div>
    }
    else
    {
        <h1>@L["profile_not_found"]</h1>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('profile-repo-search');
            var container = document.getElementById('profile-repos-container');
            if (!input || !container) return;

            var debounceTimer = null;
            var currentQuery = input.value;

            function load(q, p, gp) {
                var url = window.location.pathname + '?handler=Search&q=' + encodeURIComponent(q) + '&p=' + p + '&gp=' + gp;
                fetch(url)
                    .then(function (r) { return r.text(); })
                    .then(function (html) { container.innerHTML = html; });
            }

            input.addEventListener('input', function () {
                currentQuery = input.value;
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () { load(currentQuery, 0, 0); }, 250);
            });

            container.addEventListener('click', function (e) {
                var link = e.target.closest('a');
                if (!link) return;
                var url = new URL(link.href, window.location.href);
                if (url.searchParams.get('handler') !== 'Search') return;

                e.preventDefault();
                load(
                    url.searchParams.get('q') || '',
                    parseInt(url.searchParams.get('p') || '0', 10),
                    parseInt(url.searchParams.get('gp') || '0', 10)
                );
            });
        })();
    </script>
}
