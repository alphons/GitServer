@model GitServer.Pages.User.ProfileModel
@{
    var qParam = Uri.EscapeDataString(Model.Query);
    var prevUrl = $"?handler=Search&q={qParam}&p={Model.CurrentPage - 1}&gp={Model.GroupCurrentPage}";
    var nextUrl = $"?handler=Search&q={qParam}&p={Model.CurrentPage + 1}&gp={Model.GroupCurrentPage}";
    var groupPrevUrl = $"?handler=Search&q={qParam}&p={Model.CurrentPage}&gp={Model.GroupCurrentPage - 1}";
    var groupNextUrl = $"?handler=Search&q={qParam}&p={Model.CurrentPage}&gp={Model.GroupCurrentPage + 1}";
}
@if (!string.IsNullOrEmpty(Model.Query))
{
    <p class="search-results-info">@Model.Repos.Count @L["explore_results_for"] "<strong>@Model.Query</strong>"</p>
}

<details class="collapsible-section" open>
    <summary>@(Model.IsOwner ? L["profile_own_repos_title"] : L["profile_repos"]) (@Model.TotalCount)</summary>

    @if (Model.Repos.Any() && (Model.CurrentPage > 0 || Model.HasNextPage))
    {
        @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.HasNextPage, prevUrl, nextUrl))
    }

    @if (!Model.Repos.Any())
    {
        <div class="empty-state">@(string.IsNullOrEmpty(Model.Query) ? L["profile_no_repos"] : L["explore_no_results"])</div>
    }
    else
    {
        <div class="repo-list">
            @foreach (var repo in Model.Repos)
            {
                <div class="repo-card">
                    <div class="repo-card-header">
                        <a class="repo-name" href="/@Model.ProfileUser!.UserName/@repo.Name">
                            @repo.Name
                        </a>
                        @if (repo.IsPrivate)
                        {
                            <span class="badge badge-warning">@L["badge_private"]</span>
                        }
                        else
                        {
                            <span class="badge badge-success">@L["badge_public"]</span>
                        }
                        @if (repo.IsReadOnly)
                        {
                            <span class="badge badge-warning">@L["settings_readonly_label"]</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(repo.Description))
                    {
                        <p class="repo-description">@repo.Description</p>
                    }
                    @if (repo.IsPrivate && repo.Accesses.Any())
                    {
                        <p class="text-muted repo-collaborators">
                            @L["repo_card_collaborators"]
                            @for (var i = 0; i < repo.Accesses.Count; i++)
                            {
                                var access = repo.Accesses.ElementAt(i);
                                if (access.User != null)
                                {
                                    <a href="/User/@access.User.UserName">@access.User.UserName</a>
                                }
                                else if (access.Group != null)
                                {
                                    <span>@access.Group.Name</span>
                                }
                                if (i < repo.Accesses.Count - 1)
                                {
                                    @:,
                                }
                            }
                        </p>
                    }
                    <div class="repo-meta">
                        <span class="text-muted">@L["updated_prefix"] @TZ.ToLocal(repo.UpdatedAt).ToString("d MMM yyyy HH:mm", L.CurrentCulture)</span>
                        <span class="text-muted">@L["created_prefix"] @TZ.ToLocal(repo.CreatedAt).ToString("d MMM yyyy HH:mm", L.CurrentCulture)</span>
                    </div>
                </div>
            }
        </div>
        @if (Model.CurrentPage > 0 || Model.HasNextPage)
        {
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.HasNextPage, prevUrl, nextUrl))
        }
    }
</details>

@if (Model.IsOwner)
{
    <details class="collapsible-section" open>
        <summary>@L["profile_group_repos_title"] (@Model.GroupTotalCount)</summary>

        @if (Model.GroupRepos.Any() && (Model.GroupCurrentPage > 0 || Model.GroupHasNextPage))
        {
            @await Html.PartialAsync("_Pagination", (Model.GroupCurrentPage, Model.GroupHasNextPage, groupPrevUrl, groupNextUrl))
        }

        @if (Model.GroupRepos.Any())
        {
            <div class="repo-list">
                @foreach (var repo in Model.GroupRepos)
                {
                    <div class="repo-card">
                        <div class="repo-card-header">
                            <a class="repo-name" href="/@repo.GroupOwner!.Name/@repo.Name">
                                @repo.GroupOwner!.Name / @repo.Name
                            </a>
                            @if (repo.IsPrivate)
                            {
                                <span class="badge badge-warning">@L["badge_private"]</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@L["badge_public"]</span>
                            }
                            @if (repo.IsReadOnly)
                            {
                                <span class="badge badge-warning">@L["settings_readonly_label"]</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(repo.Description))
                        {
                            <p class="repo-description">@repo.Description</p>
                        }
                        <div class="repo-meta">
                            <span class="text-muted">@L["updated_prefix"] @TZ.ToLocal(repo.UpdatedAt).ToString("d MMM yyyy HH:mm", L.CurrentCulture)</span>
                            <span class="text-muted">@L["created_prefix"] @TZ.ToLocal(repo.CreatedAt).ToString("d MMM yyyy HH:mm", L.CurrentCulture)</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">@(string.IsNullOrEmpty(Model.Query) ? L["group_repos_empty"] : L["explore_no_results"])</p>
        }

        @if (Model.GroupRepos.Any() && (Model.GroupCurrentPage > 0 || Model.GroupHasNextPage))
        {
            @await Html.PartialAsync("_Pagination", (Model.GroupCurrentPage, Model.GroupHasNextPage, groupPrevUrl, groupNextUrl))
        }
    </details>
}
