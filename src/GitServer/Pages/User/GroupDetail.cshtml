@page "/dashboard/User/GroupDetail/{id:int}"
@model GitServer.Pages.User.GroupDetailModel
@{
	ViewData["Title"] = Model.Group?.Name ?? L["nav_groups"];
}
<div class="container">
	@if (Model.CurrentUser != null)
	{
		@await Html.PartialAsync("_ProfileHeader", Model.CurrentUser)

		@await Html.PartialAsync("_UserNav", (Model.CurrentUser.UserName!, "groups", true))
	}

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
	}

	<section class="settings-section">
		<h2>@Model.Group!.Name</h2>
		<p class="text-muted">@L["group_members_hint"]</p>

		@if (Model.Members.Count > 0)
		{
			<table class="data-table collaborators-table">
				<thead>
					<tr>
						<th>@L["settings_collaborator_user"]</th>
						<th>@L["group_role_label"]</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var member in Model.Members)
					{
						<tr>
							<td>
								<a href="/dashboard/User/@member.User.UserName" class="collaborator-user">
									<img src="@member.User.EffectiveAvatarUrl" class="avatar-img avatar-sm" alt="" />
									<span>
										<strong>@member.User.UserName</strong>
										@if (!string.IsNullOrEmpty(member.User.DisplayName))
										{
											<span class="text-muted"> — @member.User.DisplayName</span>
										}
									</span>
								</a>
							</td>
							<td>
								<form method="post" asp-page-handler="ChangeRole">
									<input type="hidden" name="memberId" value="@member.Id" />
									<select name="role" class="form-control form-control-sm" onchange="this.form.submit()" aria-label="@L["group_role_label"]">
										@foreach (var role in Enum.GetValues<GitServer.Models.GroupRole>())
										{
											<option value="@role" selected="@(member.Role == role)">@RoleName(role)</option>
										}
									</select>
								</form>
							</td>
							<td>
								<form method="post" asp-page-handler="RemoveMember">
									<input type="hidden" name="memberId" value="@member.Id" />
									<button type="submit" class="btn btn-danger btn-sm">@L["delete_button"]</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="text-muted">@L["group_no_members"]</p>
		}

		<form method="post" asp-page-handler="AddMember" class="form-inline collaborator-add-form">
			<div class="form-group collaborator-search">
				<label for="memberName">@L["settings_collaborator_username"]</label>
				<input asp-for="MemberName" id="memberName" type="text" class="form-control"
					   autocomplete="off" placeholder="@L["settings_collaborator_search_placeholder"]" data-group-id="@Model.Group!.Id" />
				<div id="memberResults" class="collaborator-results"></div>
			</div>
			<div class="form-group">
				<label for="memberRole">@L["group_role_label"]</label>
				<select asp-for="MemberRole" id="memberRole" class="form-control">
					@foreach (var role in Enum.GetValues<GitServer.Models.GroupRole>())
					{
						<option value="@role">@RoleName(role)</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-primary">@L["group_add_member"]</button>
		</form>
	</section>

	<section class="settings-section">
		<h2>@L["nav_groups"] — @L["group_repos_title"] (@Model.RepoTotalCount)</h2>
		<div id="group-repos-container" data-group-id="@Model.Group!.Id"></div>
		<script type="application/json" id="group-detail-labels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
			{
				["prev"] = L["pagination_prev"],
				["next"] = L["pagination_next"],
				["private"] = L["badge_private"],
				["public"] = L["badge_public"],
				["readOnly"] = L["settings_readonly_label"],
				["empty"] = L["group_repos_empty"],
				["create"] = L["index_empty_create"],
			}))</script>
	</section>

	@if (Model.IsOwner)
	{
	<section class="settings-section">
		<h2>@L["settings_danger_zone"]</h2>
		<form method="post" asp-page-handler="Delete"
			  data-confirm="@L.Format("confirm_delete_group", Model.Group.Name)"
			  data-confirm-ok="@L["group_delete"]" data-confirm-cancel="@L["cancel"]">
			<button type="submit" class="btn btn-danger">@L["group_delete"]</button>
		</form>
	</section>
	}
</div>

@functions {
	private string RoleName(GitServer.Models.GroupRole role) => role switch
	{
		GitServer.Models.GroupRole.Read => L["group_role_read"],
		GitServer.Models.GroupRole.Admin => L["group_role_admin"],
		_ => L["group_role_write"],
	};
}

@section Scripts {
	<script src="~/js/repo-list.js" asp-append-version="true"></script>
	<script src="~/js/collaborator-search.js" asp-append-version="true"></script>
	<script src="~/js/group-detail.js" asp-append-version="true"></script>
}
