@model GitServer.Pages.User.GroupDetailModel
@{
    var repoPrevUrl = $"?handler=Repos&id={Model.Group!.Id}&rp={Model.RepoCurrentPage - 1}";
    var repoNextUrl = $"?handler=Repos&id={Model.Group!.Id}&rp={Model.RepoCurrentPage + 1}";
}
@if (Model.Repositories.Count > 0 && (Model.RepoCurrentPage > 0 || Model.RepoHasNextPage))
{
    @await Html.PartialAsync("_Pagination", (Model.RepoCurrentPage, Model.RepoHasNextPage, repoPrevUrl, repoNextUrl))
}
@if (Model.Repositories.Count > 0)
{
    <div class="repo-list">
        @foreach (var repo in Model.Repositories)
        {
            <div class="repo-card">
                <div class="repo-card-header">
                    <a class="repo-name" href="/@Model.Group!.Name/@repo.Name">
                        @Model.Group!.Name / @repo.Name
                    </a>
                    <span class="badge @(repo.IsPrivate ? "badge-warning" : "badge-success")">
                        @(repo.IsPrivate ? L["badge_private"] : L["badge_public"])
                    </span>
                    @if (repo.IsReadOnly)
                    {
                        <span class="badge badge-warning">@L["settings_readonly_label"]</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(repo.Description))
                {
                    <p class="repo-description">@repo.Description</p>
                }
            </div>
        }
    </div>
    @if (Model.RepoCurrentPage > 0 || Model.RepoHasNextPage)
    {
        @await Html.PartialAsync("_Pagination", (Model.RepoCurrentPage, Model.RepoHasNextPage, repoPrevUrl, repoNextUrl))
    }
}
else
{
    <p class="text-muted">@L["group_repos_empty"]</p>
    <a href="/Repo/New" class="btn btn-primary">@L["index_empty_create"]</a>
}
