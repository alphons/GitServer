@page "/dashboard/User/ApiKeys"
@model GitServer.Pages.User.ApiKeysModel
@inject GitServer.Services.SiteSettingsService SiteSettings
@{
	ViewData["Title"] = L["settings_apikeys_title"];
	var apiKeyDays = (await SiteSettings.GetAsync()).ApiKeyLifetimeDays;
}
<div class="container">
	@if (Model.CurrentUser != null)
	{
		@await Html.PartialAsync("_ProfileHeader", Model.CurrentUser)

		@await Html.PartialAsync("_UserNav", (Model.CurrentUser.UserName!, "apikeys", true))
	}

	<section class="settings-section" id="apikeys-section">
		<h2>@L["settings_apikeys_title"]</h2>
		<p class="text-muted">@L["settings_apikeys_help"]</p>
		<p class="text-muted">@L.Format("settings_apikeys_lifetime", apiKeyDays)</p>

		<div id="apikeys-error" class="alert alert-danger" hidden></div>
		<div id="apikeys-new" class="alert alert-success" hidden>
			<p>@L["settings_apikeys_copy_now"]</p>
			<code id="apikeys-new-value" style="word-break:break-all"></code>
		</div>
		<div id="apikeys-list"></div>
		<script type="application/json" id="apikeys-labels">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
			{
				["none"] = L["settings_apikeys_none"],
				["readOnly"] = L["settings_apikeys_readonly_badge"],
				["name"] = L["col_name"],
				["status"] = L["admin_col_status"],
				["enabled"] = L["settings_apikeys_enabled"],
				["disabled"] = L["settings_apikeys_disabled"],
				["expired"] = L["settings_apikeys_expired"],
				["enable"] = L["settings_apikeys_enable"],
				["disable"] = L["settings_apikeys_disable"],
				["delete"] = L["delete_button"],
				["confirmDelete"] = L["settings_apikeys_delete_confirm"],
				["created"] = L["created_prefix"],
				["expires"] = L["settings_tokens_expires"],
				["lastUsed"] = L["settings_tokens_last_used"],
				["never"] = L["settings_tokens_never"],
				["failed"] = L["admin_reserved_failed"],
			}))</script>

		<form id="apikeys-form" class="form-inline">
			<div class="form-group">
				<label for="apikeys-name">@L["settings_tokens_name"]</label>
				<input id="apikeys-name" type="text" class="form-control" maxlength="100" required autocomplete="off" />
			</div>
			<div class="form-group">
				<label class="checkbox-label">
					<input id="apikeys-readonly" type="checkbox" />
					@L["settings_apikeys_readonly"]
				</label>
			</div>
			<button type="submit" class="btn btn-primary">@L["settings_apikeys_create"]</button>
		</form>
		<form id="apikeys-antiforgery">@Html.AntiForgeryToken()</form>
	</section>
</div>

@section Scripts {
	<script src="~/js/api-keys.js" asp-append-version="true"></script>
}
