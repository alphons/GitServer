@page "/Auth/ForgotPassword"
@model GitServer.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = L["forgot_password_page_title"];
}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@L["forgot_password_title"]</h1>
        <p class="text-muted">@L["forgot_password_intro"]</p>
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }
        else
        {
            <form method="post">
                <div class="form-group">
                    <label for="email">@L["email_label"]</label>
                    <input id="email" name="Email" type="email" class="form-control"
                           value="@Model.Email" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary btn-block">@L["forgot_password_submit"]</button>
            </form>
        }
        <div class="auth-links">
            <a href="/Auth/Login">@L["register_login_link"]</a>
        </div>
    </div>
</div>
