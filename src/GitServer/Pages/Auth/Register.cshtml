@page "/Auth/Register"
@model GitServer.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = L["register_page_title"];
}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@L["register_title"]</h1>
        <p class="text-muted">@L["register_intro"]</p>
        @if (Model.RegistrationDisabled)
        {
            <div class="alert alert-danger">@L["register_disabled"]</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }
            else
            {
                <form method="post">
                    <div class="form-group">
                        <label for="email">@L["email_label"]</label>
                        <input id="email" name="Email" type="email" class="form-control"
                               value="@Model.Email" required autofocus />
                    </div>
                    <div class="form-group">
                        <label>
                            <input name="AcceptTerms" type="checkbox" value="true" required />
                            @L["register_terms_agree"] <a href="/Terms" target="_blank">@L["terms_title"]</a>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">@L["register_submit"]</button>
                </form>
            }
        }
        <div class="auth-links">
            <a href="/Auth/Login">@L["register_login_link"]</a>
        </div>
    </div>
</div>
