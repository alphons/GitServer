@page "/User/Settings"
@model GitServer.wwwroot.User.UserSettingsModel
@{
    ViewData["Title"] = L["account_settings"];
}
<div class="container">
    @if (Model.CurrentUser != null)
    {
        @await Html.PartialAsync("_ProfileHeader", Model.CurrentUser)

        @await Html.PartialAsync("_UserNav", (Model.CurrentUser.UserName!, "profile", true))
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")">@Model.Message</div>
    }

    <section class="settings-section">
        <h2>@L["profile_section"]</h2>
        <form method="post" asp-page-handler="Profile">
            <div class="form-group">
                <label for="displayName">@L["display_name_label"]</label>
                <input id="displayName" name="NewDisplayName" type="text" class="form-control"
                       value="@Model.DisplayName" />
            </div>
            <div class="form-group">
                <label for="bio">@L["bio_label"]</label>
                <textarea id="bio" name="NewBio" class="form-control" rows="3">@Model.Bio</textarea>
            </div>
            <div class="form-group">
                <label for="avatarUrl">@L["avatar_url_label"]</label>
                <input id="avatarUrl" name="NewAvatarUrl" type="url" class="form-control"
                       value="@Model.AvatarUrl" />
            </div>
            <div class="form-group">
                <label for="country">@L["country_label"]</label>
                <select id="country" name="NewCountry" class="form-control">
                    <option value="">@L["country_default"]</option>
                    @foreach (var (code, name) in L.AvailableCountries())
                    {
                        <option value="@code" selected="@(code == Model.Country)">@name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="companyName">@L["company_name_label"]</label>
                <input id="companyName" name="NewCompanyName" type="text" class="form-control"
                       value="@Model.CompanyName" />
            </div>
            <div class="form-group">
                <label for="preferredLanguage">@L["preferred_language_label"]</label>
                <select id="preferredLanguage" name="NewPreferredLanguage" class="form-control">
                    <option value="">@L["preferred_language_default"]</option>
                    @foreach (var (code, name) in L.AvailableLanguages())
                    {
                        <option value="@code" selected="@(code == Model.PreferredLanguage)">@name</option>
                    }
                </select>
                <span class="form-hint">@L["preferred_language_hint"]</span>
            </div>
            <div class="form-group">
                <label for="timeZoneId">@L["timezone_label"]</label>
                <select id="timeZoneId" name="NewTimeZoneId" class="form-control">
                    <option value="">@L["timezone_default"]</option>
                    @foreach (var (id, name) in TZ.AvailableTimeZones())
                    {
                        <option value="@id" selected="@(id == Model.TimeZoneId)">@name</option>
                    }
                </select>
                <span class="form-hint">@L["timezone_hint"]</span>
            </div>
            <button type="submit" class="btn btn-primary">@L["settings_save_profile"]</button>
        </form>
    </section>

    <section class="settings-section">
        <h2>@(Model.HasPassword ? L["settings_change_password"] : L["settings_set_password"])</h2>
        @if (!Model.HasPassword)
        {
            <p class="text-muted">@L["settings_no_password_info"]</p>
        }
        <form method="post" asp-page-handler="Password">
            @if (Model.HasPassword)
            {
                <div class="form-group">
                    <label for="currentPassword">@L["settings_current_password"]</label>
                    <input id="currentPassword" name="CurrentPassword" type="password" class="form-control" />
                </div>
            }
            <div class="form-group">
                <label for="newPassword">@L["settings_new_password"]</label>
                <input id="newPassword" name="NewPassword" type="password" class="form-control" minlength="6" />
            </div>
            <button type="submit" class="btn btn-primary">@(Model.HasPassword ? L["settings_change_password"] : L["settings_set_password"])</button>
        </form>
    </section>
</div>
