@page "/Auth/ResetPassword"
@model GitServer.wwwroot.Auth.ResetPasswordModel
@{
    ViewData["Title"] = L["reset_password_page_title"];
}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@L["reset_password_title"]</h1>
        @if (Model.SuccessDone)
        {
            <div class="alert alert-success">@L["reset_password_success"]</div>
            <div class="auth-links">
                <a href="/Auth/Login">@L["register_login_link"]</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label for="password">@L["reset_password_new_password_label"]</label>
                    <input id="password" name="Password" type="password" class="form-control" required minlength="6" autofocus />
                </div>
                <div class="form-group">
                    <label for="confirmPassword">@L["confirm_password_label"]</label>
                    <input id="confirmPassword" name="ConfirmPassword" type="password" class="form-control" required minlength="6" />
                </div>
                <button type="submit" class="btn btn-primary btn-block">@L["reset_password_submit"]</button>
            </form>
        }
    </div>
</div>
